    { "id": "us-east-1", "azs": ["us-east-1a", "us-east-1b", "us-east-1c"] },
    { "id": "eu-west-1", "azs": ["eu-west-1a", "eu-west-1b", "eu-west-1c"] }
  ],
  "variants": {
